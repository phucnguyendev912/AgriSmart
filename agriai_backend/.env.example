# ============================================================
# AgriAI Backend — Environment Variables Template
# ============================================================
# Copy file này thành .env và điền giá trị thật vào
# KHÔNG commit file .env vào Git
# ============================================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/AgriAI_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here

# Gemini LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key

# DeepSeek LLM (optional)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Vision AI (local YOLO FastAPI)
# For local Docker: http://host.docker.internal:8010/predict
# For production: https://rice-disease-api.indevs.in/predict
VISION_AI_URL=http://host.docker.internal:8010/predict

# Cookie Settings
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Chatbot Config
SKILLS_BASE_PATH=./skills
CHATBOT_MAX_CONTEXT_CHARS=3000
CHATBOT_HISTORY_SIZE=6
